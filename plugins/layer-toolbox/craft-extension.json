{
  "schema": 1,
  "id": "io.github.artcraftandroid.layer-toolbox",
  "name": "Layer tools",
  "version": "1.3.0",
  "holds": ["hooks", "filter"],
  "publisher": {"name": "ProCraft"},
  "description": "Picked layers take one opacity together, paste goes into masks and the eyedropper picks from a layer; grid and paper fills; and effects, each with a switch of its own.",
  "compat": {"procraft": {"interface": 16}},
  "permissions": ["artwork.read", "artwork.write", "brush", "notice"],
  "hooks": ["opacity_together", "paste_mask", "pick_layer"],
  "controls": [
    {"key": "layer_tools", "type": "feature", "label": "Layer tools", "description": "Picked layers take one opacity together, Paste can go into a mask, and the eyedropper can pick from the current layer alone.", "hooks": ["opacity_together", "paste_mask", "pick_layer"]},
    {"key": "opacity", "type": "switch", "label": "Opacity of picked layers", "under": "layer_tools"},
    {"key": "paste", "type": "switch", "label": "Paste into masks", "starts": false, "keeps": "paste_into_mask", "under": "layer_tools"},
    {"key": "eyedropper", "type": "switch", "label": "Eyedropper picks from layer", "starts": false, "keeps": "eyedropper_layer", "under": "layer_tools"},
    {"key": "layer_fills", "type": "feature", "label": "Layer fills", "description": "Fills a layer for you: a grid in the brush's colour, or paper behind the layer's paint.", "hooks": []},
    {"key": "grid", "type": "switch", "label": "Grid layer", "under": "layer_fills"},
    {"key": "spacing", "type": "slider", "label": "Spacing", "least": 10, "most": 500, "step": 10, "starts": 100, "unit": " px", "under": "grid"},
    {"key": "line", "type": "slider", "label": "Line width", "least": 1, "most": 10, "step": 1, "starts": 2, "unit": " px", "under": "grid"},
    {"key": "paper", "type": "switch", "label": "Paper texture", "under": "layer_fills"},
    {"key": "grain", "type": "slider", "label": "Grain", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true, "under": "paper"},
    {"key": "scale", "type": "slider", "label": "Scale", "least": 1, "most": 16, "step": 0.5, "starts": 3, "unit": " px", "live": true, "under": "paper"},
    {"key": "warmth", "type": "slider", "label": "Warmth", "least": 0, "most": 1, "step": 0.01, "starts": 0.3, "shown_times": 100, "unit": "%", "live": true, "under": "paper"},
    {"key": "effects", "type": "feature", "label": "Effects", "description": "Filters for Adjustments: the lines of a scanned drawing kept off the paper, an outline, and colours held to a few flat steps.", "hooks": []},
    {"key": "extract_lines", "type": "switch", "label": "Extract lines", "under": "effects"},
    {"key": "cut", "type": "slider", "label": "Paper", "least": 0, "most": 1, "step": 0.01, "starts": 0.15, "shown_times": 100, "unit": "%", "live": true, "under": "extract_lines"},
    {"key": "soft", "type": "slider", "label": "Softness", "least": 0, "most": 0.5, "step": 0.01, "starts": 0.1, "shown_times": 100, "unit": "%", "live": true, "under": "extract_lines"},
    {"key": "keep_colour", "type": "switch", "label": "Keep the colour", "starts": false, "under": "extract_lines"},
    {"key": "outline", "type": "switch", "label": "Outline", "under": "effects"},
    {"key": "reach", "type": "slider", "label": "Width", "least": 1, "most": 12, "step": 1, "starts": 3, "unit": " px", "live": true, "under": "outline"},
    {"key": "posterise", "type": "switch", "label": "Posterise", "under": "effects"},
    {"key": "steps", "type": "slider", "label": "Steps", "least": 2, "most": 16, "step": 1, "starts": 4, "live": true, "under": "posterise"}
  ],
  "actions": [
    {"key": "add", "label": "Add a grid layer", "under": "grid"}
  ],
  "filters": [
    {"key": "paper", "label": "Paper texture", "controls": ["grain", "scale", "warmth"], "under": "paper"},
    {"key": "extract_lines", "label": "Extract lines", "controls": ["cut", "soft", "keep_colour"], "under": "extract_lines"},
    {"key": "outline", "label": "Outline", "controls": ["reach"], "under": "outline"},
    {"key": "posterise", "label": "Posterise", "controls": ["steps"], "under": "posterise"}
  ],
  "replaces": [
    {"id": "io.github.artcraftandroid.layer-tools", "switch": "layer_tools", "controls": {"opacity": "opacity"}},
    {"id": "io.github.artcraftandroid.layer-fills", "switch": "layer_fills", "controls": {"grid": "grid", "spacing": "spacing", "line": "line", "paper": "paper", "grain": "grain", "scale": "scale", "warmth": "warmth"}},
    {"id": "io.github.artcraftandroid.effects", "switch": "effects", "controls": {"extract_lines": "extract_lines", "cut": "cut", "soft": "soft", "keep_colour": "keep_colour", "outline": "outline", "reach": "reach", "posterise": "posterise", "steps": "steps"}},
    {"id": "io.github.artcraftandroid.opacity-together", "switch": "opacity"},
    {"id": "io.github.artcraftandroid.paste-into-masks", "switch": "layer_tools"},
    {"id": "io.github.artcraftandroid.eyedropper-layer", "switch": "layer_tools"},
    {"id": "io.github.artcraftandroid.grid-layer", "switch": "grid", "controls": {"spacing": "spacing", "line": "line"}},
    {"id": "io.github.artcraftandroid.paper-texture", "switch": "paper"},
    {"id": "io.github.artcraftandroid.extract-lines", "switch": "extract_lines"},
    {"id": "io.github.artcraftandroid.outline", "switch": "outline"},
    {"id": "io.github.artcraftandroid.posterise", "switch": "posterise"}
  ]
}
