{
  "schema": 1,
  "id": "io.github.artcraftandroid.infinite-plugins",
  "name": "Infinite Plugins",
  "version": "1.0.0",
  "holds": ["hooks", "filter", "brushes"],
  "publisher": {"name": "ProCraft"},
  "description": "Lasso fill, a paper for each artwork, the Solo and Trace layer views, filter layers and colour panel extras, each with a switch of its own.",
  "compat": {"procraft": {"interface": 19}},
  "permissions": ["panel"],
  "hooks": ["stroke_fill", "paper", "view_dim_others", "colour_panel"],
  "controls": [
    {"key": "lasso_fill", "type": "feature", "label": "Lasso fill", "description": "Strokes that fill what they go round: the Fills brushes it brings, any brush by its Fill row in the brush studio, or every stroke while Lasso fill is on (Actions > Canvas, or Alt+F).", "hooks": ["stroke_fill"]},
    {"key": "every", "type": "switch", "label": "Lasso fill", "starts": false, "place": "canvas", "press": "alt+f", "under": "lasso_fill"},
    {"key": "growing", "type": "switch", "label": "Show the fill while drawing", "starts": true, "under": "lasso_fill"},
    {"key": "eraser", "type": "switch", "label": "Eraser too", "starts": false, "under": "lasso_fill"},
    {"key": "paper", "type": "feature", "label": "Paper", "description": "A paper for each artwork, from Paper in the Layers panel or Actions > Canvas: every brush takes its grain, shown under the art in any colour, from the textures or your own pictures.", "hooks": ["paper"]},
    {"key": "kind", "type": "slider", "label": "Paper", "least": 0, "most": 7, "step": 1, "starts": 0, "names": ["None", "Cold press", "Hot press", "Rough", "Canvas", "Laid", "Your own", "Textures"], "place": "canvas", "artwork": true, "under": "paper"},
    {"key": "colour", "type": "slider", "label": "Paper colour", "least": 0, "most": 6, "step": 1, "starts": 0, "names": ["Background", "White", "Cream", "Ivory", "Grey", "Kraft", "Black"], "place": "canvas", "artwork": true, "under": "paper"},
    {"key": "grain", "type": "slider", "label": "Grain", "least": 0, "most": 1, "step": 0.05, "starts": 0.6, "shown_times": 100, "unit": "%", "place": "canvas", "artwork": true, "under": "paper"},
    {"key": "size", "type": "slider", "label": "Grain size", "least": 0.5, "most": 4, "step": 0.25, "starts": 1, "shown_times": 100, "unit": "%", "artwork": true, "under": "paper"},
    {"key": "shown", "type": "slider", "label": "Texture under the art", "least": 0, "most": 1, "step": 0.05, "starts": 0.3, "shown_times": 100, "unit": "%", "artwork": true, "under": "paper"},
    {"key": "tooth", "type": "slider", "label": "Tooth", "least": 0, "most": 1, "step": 0.05, "starts": 0, "shown_times": 100, "unit": "%", "artwork": true, "under": "paper"},
    {"key": "own_colour", "type": "switch", "label": "A colour of your own", "starts": false, "artwork": true, "under": "paper"},
    {"key": "hue", "type": "slider", "label": "Hue", "least": 0, "most": 360, "step": 1, "starts": 40, "unit": "°", "under": "own_colour", "artwork": true},
    {"key": "saturation", "type": "slider", "label": "Saturation", "least": 0, "most": 1, "step": 0.01, "starts": 0.1, "shown_times": 100, "unit": "%", "under": "own_colour", "artwork": true},
    {"key": "brightness", "type": "slider", "label": "Brightness", "least": 0, "most": 1, "step": 0.01, "starts": 0.96, "shown_times": 100, "unit": "%", "under": "own_colour", "artwork": true},
    {"key": "picture", "type": "file", "label": "Your own paper", "accepts": "picture", "under": "paper"},
    {"key": "texture", "type": "texture", "label": "Texture", "own": ["picture", "picture2", "picture3", "picture4"], "starts": 0, "artwork": true, "under": "paper"},
    {"key": "picture2", "type": "file", "label": "Your own paper 2", "accepts": "picture", "under": "paper"},
    {"key": "picture3", "type": "file", "label": "Your own paper 3", "accepts": "picture", "under": "paper"},
    {"key": "picture4", "type": "file", "label": "Your own paper 4", "accepts": "picture", "under": "paper"},
    {"key": "trace_view", "type": "feature", "label": "Trace view", "description": "Layer view, in the Layers panel or Actions > Canvas: Solo shows the layer you're on alone, Trace dims the rest (Alt+S, Alt+T), on the screen alone. What you save and export stays as it is.", "hooks": ["view_dim_others"]},
    {"key": "view", "type": "slider", "label": "Layer view", "least": 0, "most": 2, "step": 1, "starts": 0, "names": ["Normal", "Solo", "Trace"], "place": "canvas", "under": "trace_view"},
    {"key": "dim", "type": "slider", "label": "Trace dims the others", "least": 0.1, "most": 0.95, "step": 0.05, "starts": 0.7, "shown_times": 100, "unit": "%", "live": true, "under": "trace_view"},
    {"key": "filter_layers", "type": "feature", "label": "Filter layers", "description": "Layers of a filter from the Layers panel's +: what is below one shows changed, its value kept with it and set again any time, through its mask, opacity and blend mode.", "hooks": []},
    {"key": "colour_extras", "type": "feature", "label": "Colour extras", "description": "The colour panel's sliders step one unit at a tap on either end, and its swatch shows the colour as the panel opened beside the colour now.", "hooks": ["colour_panel"]},
    {"key": "steps", "type": "switch", "label": "Sliders step at their ends", "starts": false, "under": "colour_extras"},
    {"key": "compare", "type": "switch", "label": "Colour before and now", "starts": false, "under": "colour_extras"}
  ],
  "brush_controls": [
    {"key": "fill", "label": "Fill", "choices": ["Off", "Fill what it encloses"], "under": "lasso_fill", "from": "io.github.artcraftandroid.lasso-fill"},
    {"key": "shown", "label": "Fill shown", "choices": ["As it's drawn", "As the pen lifts"], "under": "lasso_fill", "from": "io.github.artcraftandroid.lasso-fill"}
  ],
  "brushes": {"under": "lasso_fill", "from": "io.github.artcraftandroid.lasso-fill"},
  "actions": [
    {"key": "settings", "label": "Paper", "place": "layers", "under": "paper"},
    {"key": "views", "label": "Layer view", "place": "layers", "under": "trace_view"},
    {"key": "solo", "label": "Solo", "press": "alt+s", "under": "trace_view"},
    {"key": "trace", "label": "Trace", "press": "alt+t", "under": "trace_view"}
  ],
  "filters": [
    {"key": "brightness", "label": "Brightness", "layer": true, "group": "Colour", "values": [{"key": "value", "type": "slider", "label": "Brightness", "least": -1, "most": 1, "step": 0.02, "starts": 0, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers"},
    {"key": "contrast", "label": "Contrast", "layer": true, "group": "Colour", "values": [{"key": "value", "type": "slider", "label": "Contrast", "least": -1, "most": 1, "step": 0.02, "starts": 0, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers"},
    {"key": "exposure", "label": "Exposure", "layer": true, "group": "Colour", "values": [{"key": "value", "type": "slider", "label": "Exposure", "least": -1, "most": 1, "step": 0.02, "starts": 0, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers"},
    {"key": "gamma", "label": "Gamma", "layer": true, "group": "Colour", "values": [{"key": "value", "type": "slider", "label": "Gamma", "least": -1, "most": 1, "step": 0.02, "starts": 0, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers"},
    {"key": "vibrance", "label": "Vibrance", "layer": true, "group": "Colour", "values": [{"key": "value", "type": "slider", "label": "Vibrance", "least": -1, "most": 1, "step": 0.02, "starts": 0, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers"},
    {"key": "saturation", "label": "Saturation", "layer": true, "group": "Colour", "values": [{"key": "value", "type": "slider", "label": "Saturation", "least": -1, "most": 1, "step": 0.02, "starts": 0, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers"},
    {"key": "temperature", "label": "Temperature", "layer": true, "group": "Colour", "values": [{"key": "value", "type": "slider", "label": "Temperature", "least": -1, "most": 1, "step": 0.02, "starts": 0, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers"},
    {"key": "tint", "label": "Tint", "layer": true, "group": "Colour", "values": [{"key": "value", "type": "slider", "label": "Tint", "least": -1, "most": 1, "step": 0.02, "starts": 0, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers"},
    {"key": "hue", "label": "Hue", "layer": true, "group": "Colour", "values": [{"key": "value", "type": "slider", "label": "Hue", "least": -1, "most": 1, "step": 0.02, "starts": 0, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers"},
    {"key": "curves", "label": "Curves", "layer": true, "group": "Colour", "editor": "curves", "under": "filter_layers"},
    {"key": "gradient_map", "label": "Gradient Map", "layer": true, "group": "Colour", "editor": "gradient", "under": "filter_layers"},
    {"key": "black_white", "label": "Black & White", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Black & White", "least": -1, "most": 1, "step": 0.02, "starts": 0, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers"},
    {"key": "glow", "label": "Glow", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Glow", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers"},
    {"key": "invert", "label": "Invert", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Invert", "least": -1, "most": 1, "step": 0.02, "starts": 1.0, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers"},
    {"key": "sepia", "label": "Sepia", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Sepia", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers"},
    {"key": "grain", "label": "Grain", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Grain", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "touch": "seed"},
    {"key": "bokeh", "label": "Bokeh", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Bokeh", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "reach": {"value": "value", "times": 46, "plus": 3}},
    {"key": "lens_flare", "label": "Lens Flare", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Lens Flare", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "touch": "point"},
    {"key": "blur", "label": "Blur", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Blur", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "reach": {"value": "value", "times": 63, "plus": 2}},
    {"key": "smooth", "label": "Smooth", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Smooth", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "reach": {"value": "value", "times": 3, "plus": 2}},
    {"key": "dilate", "label": "Dilate", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Dilate", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "reach": {"value": "value", "times": 8, "plus": 9}},
    {"key": "erode", "label": "Erode", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Erode", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "reach": {"value": "value", "times": 8, "plus": 9}},
    {"key": "scatter", "label": "Scatter", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Scatter", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "reach": {"value": "value", "times": 100, "plus": 1}, "touch": "seed"},
    {"key": "sharpen", "label": "Sharpen", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Sharpen", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "reach": 2},
    {"key": "emboss", "label": "Emboss", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Emboss", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "reach": 2},
    {"key": "fisheye", "label": "Fisheye", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Fisheye", "least": -1, "most": 1, "step": 0.02, "starts": 0, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "reach": "whole", "touch": "point"},
    {"key": "halftone", "label": "Halftone", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Halftone", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers"},
    {"key": "manga", "label": "Manga", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Manga", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "reach": 1},
    {"key": "hexagons", "label": "Hexagons", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Hexagons", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "reach": {"value": "value", "times": 100, "plus": 2}},
    {"key": "pixelate", "label": "Pixelate", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Pixelate", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "reach": {"value": "value", "times": 100, "plus": 1}},
    {"key": "stained_glass", "label": "Stained Glass", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Stained Glass", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "reach": "whole"},
    {"key": "stamp", "label": "Stamp", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Stamp", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers"},
    {"key": "edges", "label": "Edges", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Edges", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "reach": 1},
    {"key": "stereo", "label": "Stereo", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Stereo", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "reach": {"value": "value", "times": 256, "plus": 1}},
    {"key": "kaleidoscope", "label": "Kaleidoscope", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Kaleidoscope", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "reach": "whole", "touch": "point"},
    {"key": "direction", "label": "Direction", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Direction", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "reach": {"value": "value", "times": 64, "plus": 1}, "touch": "angle"},
    {"key": "zoom", "label": "Zoom", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Zoom", "least": 0, "most": 1, "step": 0.01, "starts": 0.5, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "reach": "whole", "touch": "point"},
    {"key": "spin", "label": "Spin", "layer": true, "group": "Filters", "values": [{"key": "value", "type": "slider", "label": "Spin", "least": -1, "most": 1, "step": 0.02, "starts": 0, "shown_times": 100, "unit": "%", "live": true}], "under": "filter_layers", "reach": "whole", "touch": "point"}
  ],
  "replaces": [
    {"id": "io.github.artcraftandroid.lasso-fill", "switch": "lasso_fill", "controls": {"every": "every", "growing": "growing", "eraser": "eraser"}},
    {"id": "io.github.artcraftandroid.paper", "switch": "paper", "controls": {"paper": "kind", "colour": "colour", "grain": "grain", "size": "size", "shown": "shown", "tooth": "tooth", "own_colour": "own_colour", "hue": "hue", "saturation": "saturation", "brightness": "brightness", "picture": "picture", "texture": "texture", "picture2": "picture2", "picture3": "picture3", "picture4": "picture4"}},
    {"id": "io.github.artcraftandroid.trace-view", "switch": "trace_view", "controls": {"view": "view", "dim": "dim"}},
    {"id": "io.github.artcraftandroid.colour-extras", "switch": "colour_extras", "controls": {"steps": "steps", "compare": "compare"}}
  ],
  "takes": [
    {"id": "io.github.artcraftandroid.view-tools", "feature": "trace_view", "switch": "trace_view", "controls": {"view": "view", "dim": "dim"}},
    {"id": "io.github.artcraftandroid.layer-toolbox", "feature": "filter_layers", "switch": "filter_layers", "filters": true},
    {"id": "io.github.artcraftandroid.colour-tools", "feature": "colour_extras", "switch": "colour_extras", "controls": {"steps": "steps", "compare": "compare"}}
  ]
}
