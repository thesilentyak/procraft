{
  "schema": 1,
  "id": "io.github.artcraftandroid.colour-tools",
  "name": "Colour tools",
  "version": "1.1.0",
  "holds": ["hooks"],
  "publisher": {"name": "ProCraft"},
  "description": "A colour triangle in Classic, colour labels on layers and ColorDrop tools, each with a switch of its own.",
  "compat": {"procraft": {"interface": 16}},
  "permissions": ["artwork.read", "artwork.write", "panel"],
  "hooks": ["picker", "floating_picker_only", "layer_label", "fill_all_layers", "fill_mask"],
  "controls": [
    {"key": "colour_triangle", "type": "feature", "label": "Colour triangle", "description": "The colour panel's Classic tab picks saturation and brightness in a triangle instead of a square, with the hue on a ring round it if you like, switched from a menu in its corner.", "hooks": ["picker", "floating_picker_only"]},
    {"key": "triangle", "type": "switch", "label": "Triangle in Classic", "starts": true, "under": "colour_triangle"},
    {"key": "ring", "type": "switch", "label": "Hue ring around the triangle", "under": "triangle"},
    {"key": "picker_only", "type": "switch", "label": "Picker only in the floating window", "under": "triangle"},
    {"key": "colour_labels", "type": "feature", "label": "Colour labels", "description": "Gives a layer or a group a colour label, one of eight, from Colour label in its options; the label shows on its row in the Layers panel and is saved with the artwork.", "hooks": ["layer_label"]},
    {"key": "colordrop", "type": "feature", "label": "ColorDrop tools", "description": "ColorDrop fills up to the lines on every layer you see, and keeps out of gaps in your lines.", "hooks": ["fill_all_layers", "fill_mask"]},
    {"key": "all_layers", "type": "switch", "label": "ColorDrop fills by all layers", "under": "colordrop"},
    {"key": "gap_closing", "type": "switch", "label": "ColorDrop gap closing", "under": "colordrop"},
    {"key": "gap", "type": "slider", "label": "Gap", "least": 0, "most": 32, "step": 1, "starts": 0, "unit": " px", "at_least": "Off", "keeps": "fill_gap", "under": "gap_closing"}
  ],
  "actions": [
    {"key": "label", "label": "Colour label", "place": "layer", "under": "colour_labels"}
  ],
