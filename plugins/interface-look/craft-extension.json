{
  "schema": 1,
  "id": "io.github.artcraftandroid.interface-look",
  "name": "Interface look",
  "version": "1.1.0",
  "holds": ["hooks"],
  "publisher": {"name": "ProCraft"},
  "description": "The interface's size, colour and notices, its sliders, the area round the canvas and coloured brush previews, each with a switch of its own.",
  "compat": {"procraft": {"interface": 16}},
  "permissions": [],
  "hooks": ["interface_scale", "interface_part_scale", "keep_clear", "interface_colour", "hide_undo_notice", "hide_notices", "slider_look", "surround_picture", "brush_preview_colour"],
  "controls": [
    {"key": "interface", "type": "feature", "label": "Interface", "description": "The interface to suit you: its size, part by part if you like, and colour, and undo and redo or everything done without a notice.", "hooks": ["interface_scale", "interface_part_scale", "keep_clear", "interface_colour", "hide_undo_notice", "hide_notices"]},
    {"key": "size_on", "type": "switch", "label": "Interface size", "under": "interface"},
    {"key": "size", "type": "slider", "label": "Size", "least": 0.75, "most": 1.25, "step": 0.05, "starts": 1, "shown_times": 100, "unit": "%", "keeps": "interface_size", "under": "size_on"},
    {"key": "parts", "type": "switch", "label": "Size parts separately", "under": "size_on"},
    {"key": "floating", "type": "slider", "label": "Floating panels", "least": 0.5, "most": 1.5, "step": 0.05, "starts": 1, "shown_times": 100, "unit": "%", "under": "parts"},
    {"key": "menus", "type": "slider", "label": "Popovers and menus", "least": 0.5, "most": 1.5, "step": 0.05, "starts": 1, "shown_times": 100, "unit": "%", "under": "parts"},
    {"key": "side_bar", "type": "slider", "label": "Side bar", "least": 0.5, "most": 1.5, "step": 0.05, "starts": 1, "shown_times": 100, "unit": "%", "under": "parts"},
    {"key": "top_bar", "type": "slider", "label": "Top bar", "least": 0.5, "most": 1.5, "step": 0.05, "starts": 1, "shown_times": 100, "unit": "%", "under": "parts"},
    {"key": "panels", "type": "slider", "label": "Panels", "least": 0.5, "most": 1.5, "step": 0.05, "starts": 1, "shown_times": 100, "unit": "%", "under": "parts"},
    {"key": "clear", "type": "switch", "label": "UI stays below status bar", "under": "size_on"},
    {"key": "colour", "type": "switch", "label": "Interface colour", "under": "interface"},
    {"key": "hue", "type": "slider", "label": "Hue", "least": 0, "most": 360, "step": 1, "starts": 212, "unit": "°", "live": true, "under": "colour"},
    {"key": "saturation", "type": "slider", "label": "Saturation", "least": 0, "most": 1, "step": 0.01, "starts": 1, "shown_times": 100, "unit": "%", "live": true, "under": "colour"},
    {"key": "hide_undo", "type": "switch", "label": "Hide undo notices", "under": "interface"},
    {"key": "hide_notices", "type": "switch", "label": "Hide all action notices", "under": "interface"},
    {"key": "slider_look", "type": "feature", "label": "Slider look", "description": "Makes the side bar's size and opacity sliders see-through frosted glass, the canvas behind them blurred and showing through.", "hooks": ["slider_look"]},
    {"key": "slider_opacity", "type": "slider", "label": "Opacity", "least": 0, "most": 1, "step": 0.01, "starts": 0.35, "shown_times": 100, "unit": "%", "live": true, "under": "slider_look"},
    {"key": "frosted", "type": "switch", "label": "Frosted", "starts": true, "under": "slider_look"},
    {"key": "canvas_surround", "type": "feature", "label": "Canvas surround", "description": "Shows the area round the canvas in a colour you pick, black too, or a picture of your own, in place of the interface's grey.", "hooks": ["interface_colour", "surround_picture"]},
    {"key": "surround_hue", "type": "slider", "label": "Hue", "least": 0, "most": 360, "step": 1, "starts": 30, "unit": "°", "live": true, "under": "canvas_surround"},
    {"key": "surround_saturation", "type": "slider", "label": "Saturation", "least": 0, "most": 1, "step": 0.01, "starts": 0.1, "shown_times": 100, "unit": "%", "live": true, "under": "canvas_surround"},
    {"key": "surround_brightness", "type": "slider", "label": "Brightness", "least": 0, "most": 1, "step": 0.01, "starts": 0.3, "shown_times": 100, "unit": "%", "live": true, "under": "canvas_surround"},
    {"key": "own_picture", "type": "switch", "label": "A picture of your own", "starts": false, "under": "canvas_surround"},
    {"key": "picture", "type": "file", "label": "Picture", "accepts": "picture", "under": "own_picture"},
    {"key": "coloured_previews", "type": "feature", "label": "Coloured brush previews", "description": "Draws the brush library's sample strokes in the colour you paint with, or a colour you pick, rather than white.", "hooks": ["brush_preview_colour"]},
    {"key": "own_colour", "type": "switch", "label": "A colour of its own", "starts": false, "under": "coloured_previews"},
    {"key": "preview_hue", "type": "slider", "label": "Hue", "least": 0, "most": 360, "step": 1, "starts": 200, "unit": "°", "under": "own_colour", "live": true},
    {"key": "preview_saturation", "type": "slider", "label": "Saturation", "least": 0, "most": 1, "step": 0.01, "starts": 0.6, "shown_times": 100, "unit": "%", "under": "own_colour", "live": true},
    {"key": "preview_brightness", "type": "slider", "label": "Brightness", "least": 0, "most": 1, "step": 0.01, "starts": 1, "shown_times": 100, "unit": "%", "under": "own_colour", "live": true},
    {"key": "chosen", "type": "switch", "label": "The brush in use too", "starts": false, "under": "coloured_previews"}
  ],
  "replaces": [
    {"id": "io.github.artcraftandroid.interface", "switch": "interface", "controls": {"size_on": "size_on", "parts": "parts", "floating": "floating", "menus": "menus", "side_bar": "side_bar", "top_bar": "top_bar", "panels": "panels", "clear": "clear", "colour": "colour", "hue": "hue", "saturation": "saturation", "hide_undo": "hide_undo", "hide_notices": "hide_notices"}},
    {"id": "io.github.artcraftandroid.slider-look", "switch": "slider_look", "controls": {"opacity": "slider_opacity", "frosted": "frosted"}},
    {"id": "io.github.artcraftandroid.canvas-surround", "switch": "canvas_surround", "controls": {"hue": "surround_hue", "saturation": "surround_saturation", "brightness": "surround_brightness", "own": "own_picture", "picture": "picture"}},
    {"id": "io.github.artcraftandroid.coloured-previews", "switch": "coloured_previews", "controls": {"own": "own_colour", "hue": "preview_hue", "saturation": "preview_saturation", "brightness": "preview_brightness", "chosen": "chosen"}},
    {"id": "io.github.artcraftandroid.interface-size", "switch": "size_on", "controls": {"clear": "clear"}},
    {"id": "io.github.artcraftandroid.interface-colour", "switch": "colour", "controls": {"hue": "hue", "saturation": "saturation"}},
    {"id": "io.github.artcraftandroid.hide-undo-notice", "switch": "hide_undo"}
  ]
}
